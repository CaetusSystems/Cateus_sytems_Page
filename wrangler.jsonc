{
  // Site da Caetus na conta Cloudflare producao.caetus (Worker + arquivos estáticos).
  // Publicar: npm run build && CLOUDFLARE_ACCOUNT_ID=e5401426d32f1245597574a8a6b2cd7b npx wrangler deploy
  // Secrets (digitados pelo dono, nunca em arquivo): RESEND_API_KEY e LEAD_TO
  //   npx wrangler secret put RESEND_API_KEY
  //   npx wrangler secret put LEAD_TO
  // Opcional (var, remetente verificado no Resend): LEAD_FROM
  "name": "caetus-site",
  "main": "worker/index.ts",
  "account_id": "e5401426d32f1245597574a8a6b2cd7b",
  "compatibility_date": "2026-10-01",
  // Endereços do site: o domínio sem www é o principal; o www redireciona (worker/index.ts).
  // Rotas na zona caetussystems.com.br (conta producao.caetus). Os registros A antigos da Vercel
  // seguem no DNS com proxy da Cloudflare, mas a rota assume o tráfego antes de chegar neles.
  // (Custom Domain recusa o deploy enquanto esses registros existirem: erro 100117.)
  "routes": [
    { "pattern": "caetussystems.com.br/*", "zone_name": "caetussystems.com.br" },
    { "pattern": "www.caetussystems.com.br/*", "zone_name": "caetussystems.com.br" }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "single-page-application",
    // Páginas passam pelo Worker (redirecionamentos e /api); arquivos estáticos vão direto.
    "run_worker_first": [
      "/*",
      "!/assets/*",
      "!/img/*",
      "!/templates/*",
      "!/mockups/*",
      "!/landing_page/*",
      "!/*.png",
      "!/*.jpg",
      "!/*.jpeg",
      "!/*.webp",
      "!/*.ico",
      "!/*.js",
      "!/*.css",
      "!/*.woff2"
    ]
  }
}
